{
  "name": "ntt-data-doorare-tools",
  "private": true,
  "version": "1.0.0",
  "description": "Repo tooling: UI artifact capture and ai-material scripts (not part of the frontend build).",
  "type": "commonjs",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "capture": "node scripts/capture-screenshots.mjs",
    "capture:dev": "node scripts/capture-screenshots.mjs --url http://127.0.0.1:5173",
    "e2e:loadmore": "node scripts/e2e-loadmore.mjs",
    "ai:index": "node scripts/ai-index.mjs",
    "ai:session": "node scripts/ai-session.mjs",
    "forecast:load": "npx tsx scripts/load-forecast.ts",
    "test:agent": "npx tsx scripts/test-agent.ts",
    "db:up": "bash scripts/db.sh up",
    "db:load": "bash scripts/db.sh load",
    "db:reset": "bash scripts/db.sh reset",
    "db:scenarios": "bash scripts/db.sh scenarios",
    "db:psql": "bash scripts/db.sh psql"
  },
  "devDependencies": {
    "playwright-core": "^1.64.0"
  }
}
