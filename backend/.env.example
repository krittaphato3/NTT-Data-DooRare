# Server Port
PORT=3001
NODE_ENV=development

# Database Connection (Postgres)
DB_HOST=doorare-db.cxw4iguq6sg9.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=doorare
DB_USER=doorare
DB_PASSWORD=doorare-password-db

# Forecast Background Job (Option A + B)
# Set to true to automatically predict every 3 days in the background
FORECAST_JOB_ENABLED=false
FORECAST_JOB_INTERVAL_DAYS=3
FORECAST_JOB_EXPORT_DB=true
