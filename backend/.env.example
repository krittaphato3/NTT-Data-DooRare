# Server Port
PORT=3001
NODE_ENV=development

# Database Connection (Postgres) - local dev database (docker compose service `db`, published on 5442).
# To connect to AWS RDS instead, set DB_HOST / DB_PORT (5432) / DB_USER / DB_PASSWORD in your own .env
# (never commit the real host or password; ask the owner for them).
DB_HOST=127.0.0.1
DB_PORT=5442
DB_NAME=doorare
DB_USER=doorare
DB_PASSWORD=doorare_dev

# Forecast Background Job (Option A + B)
# Set to true to automatically predict every 3 days in the background
FORECAST_JOB_ENABLED=false
FORECAST_JOB_INTERVAL_DAYS=3
FORECAST_JOB_EXPORT_DB=true
